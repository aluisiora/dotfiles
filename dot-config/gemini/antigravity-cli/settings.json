{
  "allowNonWorkspaceAccess": true,
  "altScreenMode": "always",
  "model": "Gemini 3.8 Flash (Medium)",
  "notifications": true,
  "permissions": {
    "allow": [
      "read_file(~)",
      "read_file(/Users/aluisio)",
      "read_file(/home/aluisio)",
      "command(find)",
      "command(cat)",
      "command(grep)",
      "command(rg)",
      "command(fd)",
      "command(awk)",
      "command(sed)",
      "command(less)",
      "command(more)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(diff)",
      "command(cmp)",
      "command(file)",
      "command(stat)",
      "command(ls)",
      "command(tree)",
      "command(bat)",
      "command(jq)",
      "command(yq)",
      "command(git diff)",
      "command(git show)",
      "command(git log)",
      "command(git status)",
      "command(git grep)",
      "command(git branch)",
      "command(git rev-parse)",
      "command(git remote)",
      "command(git tag)",
      "command(git describe)",
      "command(git ls-files)",
      "command(git check-ignore)",
      "command(git config --get)",
      "command(go)",
      "command(flutter)",
      "command(dart)",
      "command(which)",
      "command(whereis)",
      "command(type)",
      "command(cd)",
      "command(pwd)",
      "command(echo)",
      "command(printf)",
      "command(uname)",
      "command(whoami)",
      "command(id)",
      "command(df)",
      "command(du)",
      "command(ps)",
      "command(env)",
      "command(printenv)",
      "command(lsof)"
    ],
    "ask": [
      "command(go get)",
      "command(go install)",
      "command(go mod download)",
      "command(go mod tidy)",
      "command(flutter pub get)",
      "command(flutter pub upgrade)",
      "command(flutter pub add)",
      "command(dart pub get)",
      "command(dart pub upgrade)",
      "command(dart pub add)"
    ]
  },
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "~/.config/gemini/antigravity-cli/statusline.sh",
    "enabled": true
  },
  "trustedWorkspaces": [
    "~",
    "/Users/aluisio",
    "/home/aluisio",
    "~/Projects/*",
    "/Users/aluisio/Projects/*",
    "/home/aluisio/Projects/*",
    "~/.config/nvim",
    "/Users/aluisio/.config/nvim",
    "/home/aluisio/.config/nvim",
    "~/.dotfiles",
    "/Users/aluisio/.dotfiles",
    "/home/aluisio/.dotfiles"
  ],
  "verbosity": "low"
}
