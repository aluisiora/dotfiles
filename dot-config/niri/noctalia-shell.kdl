spawn-at-startup "noctalia"

binds {
    Super+Space           hotkey-overlay-title="Application launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    XF86Search            { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Comma           hotkey-overlay-title="Settings" { spawn-sh "noctalia msg settings-toggle"; }
    // Super+N               hotkey-overlay-title="Notification history" { spawn "noctalia-shell" "ipc" "call" "notifications" "toggleHistory"; }
    // Ctrl+Alt+Delete       hotkey-overlay-title="Power options" { spawn-sh "noctalia msg panel-toggle session"; }
    Super+Ctrl+Q          hotkey-overlay-title="Lock and suspend" { spawn-sh "noctalia msg session lock-and-suspend"; }
    XF86DoNotDisturb      { spawn-sh "noctalia msg notification-dnd-toggle"; }

    Super+Shift+5         { spawn-sh "noctalia msg screenshot-annotate"; }

    // Audio & Brightness
    XF86AudioPlay         allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioRaiseVolume  { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86Launch6           allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86Launch5           allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

/* Apps: blur them all without xray so it looks more realistic. */
// window-rule {
//   background-effect {
//     blur true
//     xray false
//   }
// }

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
// layer-rule {
//   match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
//   background-effect {
//     xray false
//     // blur false
//   }
// }

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

/* You can also fine-tune the blur effect globally. */
// blur {
//   passes 2        // more passes = stronger blur (default: 3)
//   offset 3.0      // sample distance per pass (default: 3.0)
//   noise 0.03      // grain overlay (default: 0.02)
//   saturation 1.0  // color saturation boost (default: 1.5)
// }

