#!/usr/bin/env zsh

WORKING_DIR=$1
SESSION_NAME=$2

if [[ -z $WORKING_DIR ]]; then
  WORKING_DIR=$({
    # Static custom directories
    echo "$HOME/.config/nvim"

    #  All main projects directly inside $HOME/Projects
    for proj in "$HOME/Projects"/*; do
      [ -d "$proj" ] && [ -e "$proj/.git" ] || continue
      echo "$proj"
    done

    # Worktrees derived from those projects
    for proj in "$HOME/Projects"/*; do
      [ -d "$proj" ] && [ -e "$proj/.git" ] || continue
      git -C "$proj" worktree list --porcelain 2>/dev/null | while read -r line; do
        case "$line" in
          "worktree "*)
            wt="${line#worktree }"
            [ "$wt" != "$proj" ] && echo "$wt"
            ;;
        esac
      done
    done
  } | awk '!seen[$0]++' | fzf)
fi

if [[ -z $WORKING_DIR ]]; then
    exit 0
fi

if [[ -z $SESSION_NAME ]]; then
  SESSION_NAME=$(basename "$WORKING_DIR" | tr . _)
fi

if [[ -z $TMUX ]] && [[ -z $(pgrep tmux) ]]; then
  echo "Creating new session: $SESSION_NAME"
  tmux new-session -d -s $SESSION_NAME -c $WORKING_DIR
fi

if ! tmux has-session -t $SESSION_NAME 2> /dev/null; then
  echo "Creating new session: $SESSION_NAME"
  tmux new-session -ds $SESSION_NAME -c $WORKING_DIR
fi

if [[ -z $TMUX ]]; then
  tmux attach -t $SESSION_NAME
  exit 0
fi

tmux switch-client -t $SESSION_NAME
